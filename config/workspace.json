{
  "version": 1,
  "name": "ai-workspace",
  "mode": "lite",
  "language": {
    "documents": "en",
    "interviews": "en"
  },
  "agents": [
    "orchestrator",
    "planner",
    "implementer",
    "reviewer",
    "qa"
  ],
  "locks": {
    "defaultTtlSeconds": 1800,
    "staleAfterSeconds": 3600,
    "maxTtlSeconds": 7200
  },
  "handoff": {
    "checkpointEveryMinutes": 20,
    "warnAfterMinutes": 30
  },
  "budget": {
    "contextTokens": 200000,
    "warnAtPercent": 70,
    "checkpointAtPercent": 85
  },
  "artifacts": {
    "quarantine": "runtime/artifacts",
    "watch": [
      "tmp",
      "temp",
      "scratch",
      ".cache",
      "ai-notes",
      "notes-ai"
    ]
  },
  "security": {
    "warnTrackedSecrets": true
  },
  "checks": []
}
