#!/usr/bin/env sh
# Run the Rust `ai` CLI from this checkout.
set -eu
HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if [ -x "$HERE/target/release/ai" ]; then
  exec "$HERE/target/release/ai" "$@"
fi
if [ -x "$HERE/target/debug/ai" ]; then
  exec "$HERE/target/debug/ai" "$@"
fi
exec cargo run --quiet --manifest-path "$HERE/Cargo.toml" -- "$@"
